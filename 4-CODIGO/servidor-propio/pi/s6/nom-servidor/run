#!/bin/sh
# NOM: el jar, con el usuario sin privilegios "nom". Ajustes en /etc/nom.conf.
exec 2>&1
VAR=/var/lib/nom
JAR=/opt/nom/nom.jar
if ! [ -s $JAR ]; then echo "nom: falta $JAR, en espera"; exec sleep 2147483647; fi
NOM_PUERTO=8080; NOM_DATOS=$VAR/datos; NOM_MEMORIA=512m
# Solo en la propia Pi (127.0.0.1): la gente entra por el túnel de Cloudflare, que corre aquí mismo.
# (Se cambia en /etc/nom.conf; por ejemplo SERVER_ADDRESS=0.0.0.0 lo abre a la red de la casa.)
SERVER_ADDRESS=127.0.0.1
[ -r /etc/nom.conf ] && . /etc/nom.conf
export NOM_PUERTO NOM_DATOS NOM_DESCUBRIMIENTO NOM_CUOTA_MB SERVER_ADDRESS
export HOME=$VAR TMPDIR=$VAR/tmp LANG=C.UTF-8
cd $VAR || exit 1
rm -rf $VAR/tmp/* 2>/dev/null
exec s6-setuidgid nom java -Xmx"$NOM_MEMORIA" -XX:+ExitOnOutOfMemoryError \
  -Djava.io.tmpdir=$VAR/tmp -Dfile.encoding=UTF-8 -jar $JAR
