<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Para escuchar el anuncio UDP de los espacios en la red local (CU-15). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- El teléfono como servidor de la red: servicio en primer plano con su notificación, y el
         Wi-Fi y el procesador despiertos mientras sirve. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 2.1 Escanear el código QR de un espacio desde la app (se pide al tocar "Escanear QR"). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Guardar exportaciones en Descargas en Android 7-9. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Sin respaldo del sistema: ni la copia en la nube ni el traspaso a otro teléfono se llevan
         los datos de la app (la sesión abierta y la llave de los documentos de este teléfono). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/sin_respaldo"
        android:dataExtractionRules="@xml/reglas_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Tema.Nom">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- DEF-49: un enlace de invitación (https://www.nom.qd.je/unirse?c=…#k=…, o con el nombre de antes) que llega por
                 mensaje abre la app y no el navegador: así la llave de un espacio cifrado (lo que va
                 después del #) llega a la app sin tener que escanear el QR con la cámara. Android lo
                 comprueba con /.well-known/assetlinks.json del servidor (huella de la llave del APK). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.nom.qd.je" android:path="/unirse" />
                <data android:scheme="https" android:host="nomcolab.dpdns.org" android:path="/unirse" />
            </intent-filter>
        </activity>
        <service
            android:name=".anfitrion.ServicioAnfitrion"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Servidor de la red local: comparte los documentos de NOM con otros equipos de la misma red" />
        </service>
    </application>

</manifest>
